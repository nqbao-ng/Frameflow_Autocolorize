FRAMEFLOW_CV_API_KEY=change_this_secret
FRAMEFLOW_MAX_IMAGE_BYTES=12582912
FRAMEFLOW_HTTP_TIMEOUT=25

# Optional: only for Auto Suggest via AWS Bedrock Nova, not for image generation
